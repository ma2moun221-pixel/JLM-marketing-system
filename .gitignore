# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite dev database
/prisma/*.db
/prisma/*.db-journal
*.db
*.db-journal

# locally-stored uploaded knowledge-base files (swap for Vercel Blob/S3 in prod)
/uploads

# Python
__pycache__/
*.py[cod]

# fonts are kept once in brand/jlm/fonts
/marketing/videos/*/assets/fonts/
/marketing/videos/*/out/*.wav

# review stills (regenerated)
/marketing/videos/*/review/
/marketing/videos/*/out/*_tmp.mp4
/marketing/videos/jlm-care-icons/out/mov/
/marketing/videos/jlm-penetrating-oil/.hyperframes/artifacts/
/marketing/videos/jlm-penetrating-oil/renders/*_tmp*
/marketing/videos/jlm-penetrating-oil/node_modules/
